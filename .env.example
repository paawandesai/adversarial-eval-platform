# Copy to .env and fill in the secrets:  cp .env.example .env
# .env is gitignored. Real seeded-user credentials live in the gitignored
# creds file (docs/w3-test-creds.md), never in this template.
# Load into a shell with:  set -a; . ./.env; set +a

# ---- Deployed target (Clinical Co-Pilot) ---------------------------------
export TARGET_BASE_URL='https://64.177.42.210:8443'
export TARGET_OAUTH_TOKEN_URL='https://64.177.42.210:9300/oauth2/default/token'
export TARGET_OAUTH_CLIENT_ID='<oauth client id>'
export TARGET_OAUTH_CLIENT_SECRET='<oauth client secret>'
export TARGET_VERIFY_TLS='false'          # target uses a self-signed cert

# ---- Seeded test-user credentials (from the gitignored creds file) -------
# The client reads TARGET_<ROLE>_USERNAME / TARGET_<ROLE>_PASSWORD per role.
export TARGET_PHYSICIAN_USERNAME='<w3-physician username>'
export TARGET_PHYSICIAN_PASSWORD='<w3-physician password>'
export TARGET_NURSE_USERNAME='<w3-nurse username>'
export TARGET_NURSE_PASSWORD='<w3-nurse password>'
export TARGET_RESIDENT_USERNAME='<w3-resident username>'
export TARGET_RESIDENT_PASSWORD='<w3-resident password>'

# Optional: a default patient id when a case/turn carries none.
# export TARGET_PATIENT_ID=''

# ---- Model routing (per-agent; see aep/models/router.py) ------------------
# Each agent routes independently; unset keys fall back to the local model.
export REDTEAM_MODEL='ollama:llama3.1'
export JUDGE_MODEL='deepseek:deepseek-chat'
export DOCUMENTATION_MODEL='ollama:llama3.1'
export OLLAMA_HOST='http://localhost:11434'
export DEEPSEEK_API_KEY='<deepseek api key>'   # billing must be funded (a 402 errors the judge)
# export DEEPSEEK_BASE_URL='https://api.deepseek.com'
# export ANTHROPIC_API_KEY='<anthropic api key>' # only if an agent routes to Claude

# ---- Judge grey-box audit reads (target's Langfuse project) --------------
export AUDIT_LANGFUSE_HOST='<langfuse host>'
export AUDIT_LANGFUSE_PUBLIC_KEY='<pk>'
export AUDIT_LANGFUSE_SECRET_KEY='<sk>'

# ---- Platform's own observability (separate Langfuse project) ------------
export LANGFUSE_HOST='<langfuse host>'
export LANGFUSE_PUBLIC_KEY='<pk>'
export LANGFUSE_SECRET_KEY='<sk>'
# Dashboard trace links: the <id> in the Langfuse UI's /project/<id>/traces URLs.
export LANGFUSE_PROJECT_ID='<project id>'
